<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_manual_book_gab_tree" model="ir.ui.view">
        <field name="name">manual.book.gab.tree</field>
        <field name="model">manual.book.gab</field>
        <field name="arch" type="xml">
            <tree decoration-info="state == 'draft'" decoration-success="state == 'published'">
                <!-- <field name="sequence" widget="handle"/> -->
                <field name="number"/>
                <field name="name"/>
                <field name="category"/>
                <field name="author_id"/>
                <field name="date_published"/>
                <field name="state" widget="badge" decoration-info="state == 'draft'" decoration-warning="state == 'review'" decoration-success="state == 'published'"/>
            </tree>
        </field>
    </record>

    <record id="view_manual_book_gab_form" model="ir.ui.view">
        <field name="name">manual.book.gab.form</field>
        <field name="model">manual.book.gab</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_review" string="Ajukan Peninjauan" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_publish" string="Terbitkan" type="object" class="oe_highlight" invisible="state != 'review'"/>
                    <button name="action_draft" string="Kembali ke Draft" type="object" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,review,published"/>
                    <button name="%(manual_book_gab.action_manual_book_print_wizard)d" 
                            string="Download Bukti" 
                            type="action" 
                            class="oe_highlight" 
                            context="{'default_manual_book_id': active_id}"
                            invisible="state == 'draft'"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="number" readonly="1"/>
                        </h1>
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Judul Manual Book..." readonly="state != 'draft'"/>
                        </h1>
                    </div>
                    <group>
                        <group name="left_info">
                            <field name="category" readonly="state != 'draft'"/>
                            <field name="author_id" readonly="1" options="{'no_open': True}"/>
                        </group>
                        <group name="right_info">
                            <field name="date_published" readonly="state != 'draft'"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Konten Dokumentasi" name="content_page">
                            <field name="content" widget="html" options="{'style-inline': true}" readonly="state != 'draft'"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_manual_book_gab" model="ir.actions.act_window">
        <field name="name">Manual Book GAB</field>
        <field name="res_model">manual.book.gab</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Belum ada panduan. Mulai buat dokumentasi pertamamu!
            </p>
        </field>
    </record>

    <menuitem id="menu_manual_gab_root" name="GAB Manual" sequence="10"/>
    <menuitem id="menu_manual_gab_list" name="Daftar Panduan" parent="menu_manual_gab_root" action="action_manual_book_gab" sequence="10"/>
    <menuitem id="menu_manual_gab_reporting" name="Reporting" parent="menu_manual_gab_root" sequence="20"/>
    <menuitem id="menu_manual_gab_report_wizard" name="Laporan Rekapitulasi" parent="menu_manual_gab_reporting" action="action_manual_book_print_wizard" sequence="10"/>
</odoo>