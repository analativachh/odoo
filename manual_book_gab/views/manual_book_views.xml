<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_manual_book_gab_tree" model="ir.ui.view">
        <field name="name">manual.book.gab.tree</field>
        <field name="model">manual.book.gab</field>
        <field name="arch" type="xml">
            <tree decoration-info="state == 'draft'">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category"/>
                <field name="author_id"/>
                <field name="state" widget="badge"/>
            </tree>
        </field>
    </record>

    <record id="view_manual_book_gab_form" model="ir.ui.view">
        <field name="name">manual.book.gab.form</field>
        <field name="model">manual.book.gab</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_review" string="Ajukan Peninjauan" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_publish" string="Terbitkan" type="object" class="oe_highlight" invisible="state != 'review'"/>
                    <button name="action_draft" string="Kembali ke Draft" type="object" invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,review,published"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Judul Manual Book..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="category"/>
                            <field name="author_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="date_published"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Konten Dokumentasi">
                            <field name="content" widget="html" options="{'style-inline': true}"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_manual_book_gab" model="ir.actions.act_window">
        <field name="name">Manual Book GAB</field>
        <field name="res_model">manual.book.gab</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_manual_gab_root" name="GAB Manual" sequence="1"/>
    <menuitem id="menu_manual_gab_list" name="Daftar Panduan" parent="menu_manual_gab_root" action="action_manual_book_gab"/>
</odoo>