<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_manual_book" model="ir.actions.report">
        <field name="name">Cetak Panduan (PDF)</field>
        <field name="model">manual.book.gab</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">manual_book_gab.report_manual_book_template</field>
        <field name="report_file">manual_book_gab.report_manual_book_template</field>
    </record>

    <record id="action_report_manual_book_summary" model="ir.actions.report">
        <field name="name">Rekapitulasi Manual Book</field>
        <field name="model">manual.book.gab</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">manual_book_gab.report_summary_excel_template</field>
        <field name="report_file">manual_book_gab.report_summary_excel_template</field>
    </record>

    <template id="report_summary_excel_template">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <h2 class="text-center">Ringkasan Daftar Panduan GAB</h2>
                    <table class="table table-bordered mt-4">
                        <thead>
                            <tr style="background-color: #f2f2f2;">
                                <th>Ref Number</th>
                                <th>Title</th>
                                <th>Category</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="docs" t-as="o">
                                <tr>
                                    <td><span t-field="o.number"/></td>
                                    <td><span t-field="o.name"/></td>
                                    <td><span t-field="o.category"/></td>
                                    <td><span t-field="o.date_published"/></td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <template id="report_manual_book_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page" style="page-break-after: always;">
                        <h2 class="text-center">Manual Book Report</h2>
                        <table class="table table-sm mt48">
                            <tr>
                                <td><strong>Ref Number</strong></td>
                                <td>: <span t-field="o.number"/></td>
                                <td><strong>Date</strong></td>
                                <td>: <span t-field="o.date_published"/></td>
                            </tr>
                            <tr>
                                <td><strong>Title</strong></td>
                                <td colspan="3">: <span t-field="o.name"/></td>
                            </tr>
                        </table>
                        <div class="mt32" t-field="o.content"/>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>